---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

{% assign page_title_en = page.title %}
{% assign page_title_zh = page.title_zh | default: page.title %}
{% assign page_description_en = page.description %}
{% assign page_description_zh = page.description_zh | default: page.description %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      <span
        data-en="{{ page_title_en | escape }}"
        data-zh="{{ page_title_zh | escape }}"
      >
        {{ page_title_en }}
      </span>
    </h1>

    {% if page.description %}
      <p class="post-description">
        <span
          data-en="{{ page_description_en | escape }}"
          data-zh="{{ page_description_zh | escape }}"
        >
          {{ page_description_en }}
        </span>
      </p>
    {% endif %}
  </header>


  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
